# ── web/.env.example ──
# Vite env vars must start with VITE_ to be exposed to the browser.
# Copy to web/.env.local and fill in values.

# API base URL — Vite dev proxy rewrites /api → localhost:8080/v1
# For production, set to your actual API URL.
VITE_API_BASE_URL=http://localhost:8080/v1

# Sentry DSN (optional — leave empty to disable)
VITE_SENTRY_DSN=
