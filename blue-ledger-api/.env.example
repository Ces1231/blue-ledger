# Blue Ledger API — Environment Variables
# Copy to .env and fill in all values before running

# ── Server ───────────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8080
API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3001

# ── Database (local docker-compose) ─────────────────────────────────────────
DATABASE_URL=postgres://blue_ledger:localpassword@localhost:5432/blue_ledger?sslmode=disable

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (JWT RS256) ─────────────────────────────────────────────────────────
# Generate RSA key pair: make gen-keys  (or see README)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# ── Magic Links ──────────────────────────────────────────────────────────────
MAGIC_LINK_EXPIRY=15m
MAGIC_LINK_HMAC_SECRET=replace-with-32-random-bytes-hex

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@blueledger.io
EMAIL_FROM_NAME=The Blue Ledger

# ── Storage (Cloudflare R2) ──────────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=blue-ledger-assets
R2_PUBLIC_URL=https://assets.blueledger.io

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE_IP=100
RATE_LIMIT_PER_MINUTE_USER=1000
