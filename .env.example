# ══════════════════════════════════════════════════════════════
# .env.example — The Blue Ledger (Root)
# Copy to .env and fill in real values.
# This file mirrors blue-ledger-api/.env.example
# ══════════════════════════════════════════════════════════════

# ── API Backend (blue-ledger-api) ──
APP_ENV=development
PORT=8080
API_BASE_URL=http://localhost:8080

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001

# ── Database ──
DATABASE_URL=postgres://blue_ledger_app:changeme@localhost:5432/blue_ledger?sslmode=disable

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── JWT (RS256) ──
# Generate keypair: openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h

# ── Magic Links ──
MAGIC_LINK_SECRET=change-me-magic-link-secret-32-chars
MAGIC_LINK_TTL=15m
MAGIC_LINK_BASE_URL=http://localhost:3001/magic

# ── Resend (Transactional Email) ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_ADDRESS=noreply@yourdomain.com
RESEND_FROM_NAME=The Blue Ledger

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=blue-ledger-assets
R2_PUBLIC_URL=https://assets.yourdomain.com

# ── Stripe (Platform Billing) ──
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_STARTER=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxx

# ── Sentry ──
SENTRY_DSN=

# ── Rate Limiting ──
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=50

# ── Frontend (web) ──
VITE_API_BASE_URL=http://localhost:8080/v1
